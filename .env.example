# -----------------------------------------------------------------------------
# Public (exposed to the browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Server only — NEVER prefix with NEXT_PUBLIC_
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to hash OTP codes, IPs and download release tokens (32+ random chars)
APP_SECRET=

# Google Sheets — service account with Editor access to each lead sheet.
# Sheet IDs/tabs per form are managed in Admin → Settings → Forms.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n line breaks
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Nodemailer SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Litensity <no-reply@example.com>"
# Fallback recipient when a form has no nominated recipients configured
MAIL_FALLBACK_TO=

# OTP: "email" (default, uses SMTP) or "sms" (requires an SMS provider adapter)
OTP_CHANNEL=email
# Development only: log OTP codes to the server console instead of sending
OTP_DEV_LOG=false

# Map tiles (Leaflet adapter). Default: OpenStreetMap standard tiles — fine for development,
# but OSM's usage policy requires a commercial tile provider (or Google Maps adapter) for production.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
